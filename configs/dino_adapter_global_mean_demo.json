{
  "comment": "Exact settings for figures/dino_adapter_steering/global_mean (single mean vector on every token).",
  "base_config": "configs/dino_adapter.json",
  "directions": "out/dirv3_full100.pt",
  "demo_command": [
    "python", "scripts/dino_adapter_demo_renorm.py",
    "--config", "configs/dino_adapter.json",
    "--dataset", "out/dataset200",
    "--adapters", "out/adapters200",
    "--directions", "out/dirv3_full100.pt",
    "--output", "out/demo_global_fine",
    "--split", "test",
    "--n", "2",
    "--alphas", "0.025", "0.03", "0.035", "0.04",
    "--variants", "adapter_mean", "image_mean",
    "--device", "cuda:0"
  ],
  "intervention": {
    "blocks": "all",
    "step": 0,
    "simultaneous": true,
    "hook": "MultiImageBlockHook",
    "edits": {
      "adapter_mean": "RenormAdapterEdit(adapters[b], vectors[b]['z_mean'], alpha, renorm=True)",
      "image_mean": "RenormImageEdit(vectors[b]['h_mean'], alpha, renorm=True)"
    },
    "note": "z_mean / h_mean are one vector (mean over all tokens of the paired delta) broadcast to every image token; no ROI mask averaging.",
    "direction_space": "adapter_z",
    "direction_roi": "full",
    "n_train_pairs": 100,
    "renorm": true
  },
  "example_sample_id": "glasses_181_1"
}
